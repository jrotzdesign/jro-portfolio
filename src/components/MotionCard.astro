---
// One motion piece (see src/data/motion.js). Behaviour lives in src/scripts/motion-player.js.
const { m } = Astro.props;
---
<figure class="mo" data-src={m.src} data-loop={m.loop} data-start={m.start} data-end={m.end} data-view={m.view} data-fit={m.fit ?? 'contain'} style={[m.bg && `--mo-bg:${m.bg}`, m.inset && `--mo-inset:${m.inset}%`].filter(Boolean).join(';') || undefined}>
  <div class="mo__stage"></div>
  <figcaption class="mono"><span>{m.name}</span>{m.loop === 'hold' && <span class="mo__replay" aria-hidden="true">↻</span>}</figcaption>
</figure>
