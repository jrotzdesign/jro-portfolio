---
// One motion piece (see src/data/motion.js). Behaviour lives in src/scripts/motion-player.js.
const { m } = Astro.props;
---
<figure class="mo" data-type={m.t} data-src={m.src} data-loop={m.loop} data-end={m.end} data-fit={m.fit ?? 'contain'} style={`--mo-bg:${m.bg}${m.inset ? `;--mo-inset:${m.inset}%` : ''}`}>
  <div class="mo__stage">
    {m.t === 'video' && <video src={m.src} poster={m.poster} muted loop playsinline preload="none" aria-label={m.name}></video>}
  </div>
  <figcaption class="mono"><span>{m.name}</span>{m.loop === 'hold' && <span class="mo__replay" aria-hidden="true">↻</span>}</figcaption>
</figure>
