---
// The three page links, in order, for the home nav and the inner-page top bars. `current` marks the page you are on.
// data-astro-reload: a menu click is a normal page load, not the router's in-page swap (which was seen stalling for a visitor).
const { current } = Astro.props;
const links = [['work', '/work/', 'Projects'], ['motion', '/in-motion/', 'In motion'], ['contact', '/contact/', 'Contact']];
---
{links.map(([key, href, label]) => <a class="t" href={href} data-astro-reload aria-current={current === key ? 'page' : undefined}>{label}</a>)}
