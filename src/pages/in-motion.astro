---
import Base from '../layouts/Base.astro';
import MotionCard from '../components/MotionCard.astro';
import { motion, FAMILIES } from '../data/motion.js';
import { bySlug } from '../data/projects.js';
const brand = motion.filter((m) => m.project && bySlug[m.project]?.g === 'mozart');
const jro = motion.filter((m) => m.project && bySlug[m.project]?.g === 'jro');
const groups = FAMILIES.map((f) => ({ f, items: motion.filter((m) => m.family === f) })).filter((g) => g.items.length);
const nFacility = groups.reduce((n, g) => n + g.items.length, 0);
---
<Base title="In motion — Jose Ortiz" description="Logo intros, icon loops and website motion from brand work at Mozart&Co. and JRO Design.">
<main class="pp reel" id="reel">
  <div class="pp__bar">
    <div class="l"><a class="x" href="/#index">← Index</a><span>In motion</span></div>
    <div class="l"><span>{motion.length} pieces</span></div>
  </div>

  <header class="reel__head">
    <h1 class="display" data-in>In motion</h1>
    <p data-in>Logo intros, icon loops and website motion. Everything loops while it’s on screen; click a piece to restart it.</p>
  </header>

  <section class="reel__group" aria-labelledby="g1">
    <div class="pp__motion-head"><h2 class="display" id="g1">Brand systems</h2><div class="mono">{brand.length} pieces · each links to its project</div></div>
    <div class="reel__grid">
      {brand.map((m) => (
        <div class="reel__item">
          <MotionCard m={m} />
          <a class="reel__link mono" href={`/work/${m.project}/`}>{bySlug[m.project]?.t ?? m.project} →</a>
        </div>
      ))}
    </div>
  </section>

  <section class="reel__group" aria-labelledby="g3">
    <div class="pp__motion-head"><h2 class="display" id="g3">JRO Design</h2><div class="mono">{jro.length} pieces · independent work</div></div>
    <div class="reel__grid">
      {jro.map((m) => (
        <div class="reel__item">
          <MotionCard m={m} />
          <a class="reel__link mono" href={`/work/${m.project}/`}>{bySlug[m.project]?.t ?? m.project} →</a>
        </div>
      ))}
    </div>
  </section>

  <section class="reel__group" aria-labelledby="g2">
    <div class="pp__motion-head"><h2 class="display" id="g2">Facility logo intros</h2><div class="mono">{nFacility} pieces · at Mozart&amp;Co. · grouped by operator</div></div>
    {groups.map((g) => (
      <div class="reel__fam">
        <div class="mono reel__famh">{g.f === 'More' ? 'More facilities' : g.f}<span>{g.items.length}</span></div>
        <div class="reel__grid">{g.items.map((m) => <div class="reel__item"><MotionCard m={m} /></div>)}</div>
      </div>
    ))}
  </section>

  <div class="pp__next">
    <a href="/#index" class="p"><span class="mono">← Back</span><b>All projects</b></a>
    <a href="/#contact" class="n"><span class="mono">Next →</span><b>Get in touch</b></a>
  </div>
</main>

<script>
  import { initReel, destroyReel } from '../scripts/reel.js';
  document.addEventListener('astro:page-load', () => { if (document.getElementById('reel')) initReel(); });
  document.addEventListener('astro:before-swap', destroyReel);
</script>
</Base>
