---
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import MotionCard from '../../components/MotionCard.astro';
import Film from '../../components/Film.astro';
import { projects } from '../../data/projects.js';
import { motionFor } from '../../data/motion.js';

export function getStaticPaths() {
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { p, i } }));
}
const { p, i } = Astro.props;
const n = projects.length;
const prev = projects[(i - 1 + n) % n], next = projects[(i + 1) % n];
const pad = (x) => String(x).padStart(2, '0');
const credit = p.g === 'mozart' ? 'At Mozart&Co.' : 'JRO Design · independent';
const mo = motionFor(p.slug);
const ink = (hex) => { const n = parseInt(hex.slice(1), 16); return ((n >> 16) * 299 + ((n >> 8) & 255) * 587 + (n & 255) * 114) / 1000 > 150 ? 'var(--ink)' : 'var(--bone)'; };
---
<Base title={`${p.t} — Jose Ortiz`} description={p.intro} image={p.img ?? '/og.jpg'}>
<main class="pp" id="work" data-slug={p.slug} data-prev={`/work/${prev.slug}/`} data-next={`/work/${next.slug}/`}>
  <div class="pp__bar">
    <div class="l"><a class="x" href="/#index">← Index</a><span id="ppN">{pad(i + 1)} / {pad(n)}</span></div>
    <div class="l"><a href={`/work/${prev.slug}/`} rel="prev">Prev</a><a href={`/work/${next.slug}/`} rel="next">Next →</a></div>
  </div>

  <div class="pp__hero" id="ppHero"><Media p={p} loading="eager" /></div>

  <div class="pp__head">
    <h1 class="display" data-in>{p.t}</h1>
    <div class="pp__meta" data-in>
      <div><b>Client</b><span>{p.client}</span></div>
      <div><b>Role</b><span>{p.role}</span></div>
      <div><b>Year</b><span>{p.year}</span></div>
      <div><b>Stack</b><span>{p.stack}</span></div>
    </div>
  </div>

  <div class="pp__intro">
    <p data-in>{p.intro}</p>
    <ul class="pp__did" data-in>{p.did.map((d) => <li>{d}</li>)}</ul>
  </div>

  {p.story && (
    <section class="pp__story" aria-label="The project">
      {p.story.map((c, k) => (
        <div class="pp__chap" data-rv>
          <div class="mono">{pad(k + 1)}</div>
          <h2 class="display">{c.h}</h2>
          <p>{c.p}</p>
        </div>
      ))}
    </section>
  )}

  {mo.length > 0 && (
    <section class="pp__motion" aria-label="In motion">
      <div class="pp__motion-head">
        <h2 class="display">In motion</h2>
        <div class="mono">{mo.length} {mo.length === 1 ? 'piece' : 'pieces'} · loops while in view · <a href="/in-motion/">All motion →</a></div>
      </div>
      <div class={`pp__mgrid n${Math.min(mo.length, 3)}`}>{mo.map((m) => <MotionCard m={m} />)}</div>
    </section>
  )}

  {p.brand && (
    <section class="pp__brand" aria-label="Type and colour">
      {p.brand.type && (
        <div class="pp__type" data-rv>
          <div class="mono pp__lbl">Typography</div>
          {p.brand.type.map((t) => <div class="pp__face"><b>{t.name}</b><span class="mono">{t.role}</span></div>)}
        </div>
      )}
      {p.brand.palette && (
        <div class="pp__pal" data-rv>
          <div class="mono pp__lbl">Colour</div>
          <div class="pp__sw">
            {p.brand.palette.map((c) => (
              <button type="button" class="sw" data-hex={c.hex} style={`--c:${c.hex};--t:${ink(c.hex)}`} aria-label={`Copy ${c.name} ${c.hex}`}>
                <span class="sw__n">{c.name}</span><span class="sw__h mono">{c.hex}</span>
              </button>
            ))}
          </div>
        </div>
      )}
    </section>
  )}

  {p.films && p.films.length > 0 && (
    <section class="pp__films" aria-label="Films">
      <div class="pp__motion-head"><h2 class="display">{p.films.length === 1 ? 'Film' : 'Films'}</h2><div class="mono">Plays here · sound on</div></div>
      <div class={`pp__fgrid n${Math.min(p.films.length, 2)}`}>{p.films.map((f) => <Film f={f} />)}</div>
    </section>
  )}

  {p.gallery.length > 0 && (
    <div class="pp__gal">
      {p.gallery.map((g) => <figure class={g.wide ? 'wide' : ''} data-rv><img src={g.src} loading="lazy" decoding="async" alt="" /></figure>)}
    </div>
  )}

  <div class="pp__out">
    <h2 class="display" data-rv>{p.outcome}</h2>
    <div data-rv>
      <div class="mono" style="opacity:.55;margin-bottom:.6rem">{credit}</div>
      {p.links.length > 0 && <div class="pp__links">{p.links.map(([label, url]) => <a href={url} target="_blank" rel="noopener">{label}</a>)}</div>}
    </div>
  </div>

  <div class="pp__next">
    <a href={`/work/${prev.slug}/`} class="p"><span class="mono">← Previous</span><b>{prev.t}</b></a>
    <a href={`/work/${next.slug}/`} class="n"><span class="mono">Next →</span><b>{next.t}</b></a>
  </div>
</main>

<script>
  import { initWork, destroyWork } from '../../scripts/work.js';
  document.addEventListener('astro:page-load', () => { if (document.getElementById('work')) initWork(); });
  document.addEventListener('astro:before-swap', destroyWork);
</script>
</Base>
