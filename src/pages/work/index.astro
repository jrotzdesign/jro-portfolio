---
import Base from '../../layouts/Base.astro';
import ProjectIndex from '../../components/ProjectIndex.astro';
import SiteLinks from '../../components/SiteLinks.astro';
import { projects } from '../../data/projects.js';
import { PAGES } from '../../data/seo.js';
---
<Base title={PAGES.work.title} description={PAGES.work.description}>
<main class="pp" id="page" data-esc="/">
  <div class="pp__bar">
    <div class="l"><a class="x" href="/">← Home</a><span class="sl"><SiteLinks current="work" /></span></div>
    <div class="l"><span class="meta">{projects.length} projects</span></div>
  </div>

  <section class="index index--page" id="index">
    <ProjectIndex eager={4}>
      <h1 slot="title" class="display" data-in>Projects</h1>
    </ProjectIndex>
  </section>
</main>

<script>
  import { initPage, destroyPage } from '../../scripts/page.js';
  document.addEventListener('astro:page-load', () => { if (document.getElementById('page')) initPage(); });
  document.addEventListener('astro:before-swap', destroyPage);
</script>
</Base>
